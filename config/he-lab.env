# Shared non-secret settings for direct K3s deployment and benchmark Jobs.
# Edit this file before pushing when the namespace, registry, tags, or service
# names change. Environment variables supplied by the shell still take priority.

: "${HE_NAMESPACE:=he-dev}"

# Keep certificate verification enabled. Use true only as a temporary
# workaround for a lab K3s API certificate that cannot be verified.
: "${HE_KUBECTL_INSECURE_SKIP_TLS_VERIFY:=false}"

: "${HE_IMAGE_REPOSITORY:=docker.io/dockerboi99/he_k8s}"
# These moving tags are convenient initial defaults. On cached work-server
# mirrors, deploy cpu-<short-commit-sha> and gpu-<short-commit-sha> instead.
: "${HE_CPU_IMAGE_TAG:=cpu-latest}"
: "${HE_GPU_IMAGE_TAG:=gpu-latest}"
: "${HE_CPU_IMAGE:=${HE_IMAGE_REPOSITORY}:${HE_CPU_IMAGE_TAG}}"
: "${HE_GPU_IMAGE:=${HE_IMAGE_REPOSITORY}:${HE_GPU_IMAGE_TAG}}"
: "${HE_FIDES_EXAMPLES_IMAGE:=${HE_GPU_IMAGE}}"
: "${HE_BENCH_CLIENT_IMAGE:=${HE_CPU_IMAGE}}"
# Leave stress-Job images empty by default. Their scripts copy the immutable
# image reference from the live CPU evaluator Deployment instead of silently
# falling back to cpu-latest. Set either only as an explicit override.
: "${HE_COMPARE_IMAGE:=}"
: "${HE_COMPARE_DATA_IMAGE:=}"
: "${HE_COMPARE_DATA_PVC:=he-comparison-data}"
: "${HE_COMPARE_DATA_STORAGE:=10Gi}"

: "${HE_CPU_DEPLOYMENT:=he-evaluator-cpu}"
: "${HE_GPU_DEPLOYMENT:=he-evaluator-gpu}"
: "${HE_CPU_SERVICE:=he-evaluator}"
: "${HE_GPU_SERVICE:=he-evaluator-gpu}"
: "${HE_SERVICE_PORT:=8080}"
: "${HE_CPU_LOCAL_PORT:=18080}"
: "${HE_GPU_LOCAL_PORT:=18081}"

: "${HE_CPU_SERVICE_URL:=http://${HE_CPU_SERVICE}:${HE_SERVICE_PORT}/v1/evaluate}"
: "${HE_GPU_SERVICE_URL:=http://${HE_GPU_SERVICE}:${HE_SERVICE_PORT}/v1/evaluate}"

# Evaluator Pod resource requests reserve scheduler capacity. Limits cap the
# maximum CPU/memory available to each evaluator container.
: "${HE_CPU_REQUEST_CPU:=1}"
: "${HE_CPU_REQUEST_MEMORY:=2Gi}"
: "${HE_CPU_LIMIT_CPU:=4}"
: "${HE_CPU_LIMIT_MEMORY:=8Gi}"

: "${HE_GPU_REQUEST_CPU:=2}"
: "${HE_GPU_REQUEST_MEMORY:=4Gi}"
: "${HE_GPU_LIMIT_CPU:=8}"
: "${HE_GPU_LIMIT_MEMORY:=16Gi}"
: "${HE_GPU_COUNT:=1}"
