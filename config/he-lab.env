# Shared non-secret settings for direct K3s deployment and benchmark Jobs.
# Edit this file before pushing when the namespace, registry, tags, or service
# names change. Environment variables supplied by the shell still take priority.

: "${HE_NAMESPACE:=he-dev}"

# Keep certificate verification enabled. Use true only as a temporary
# workaround for a lab K3s API certificate that cannot be verified.
: "${HE_KUBECTL_INSECURE_SKIP_TLS_VERIFY:=false}"

: "${HE_IMAGE_REPOSITORY:=docker.io/dockerboi99/he_k8s}"
# These moving tags are convenient initial defaults. On cached work-server
# mirrors, deploy cpu-<short-commit-sha> and gpu-<short-commit-sha> instead.
: "${HE_CPU_IMAGE_TAG:=cpu-latest}"
: "${HE_GPU_IMAGE_TAG:=gpu-latest}"
: "${HE_NOTEBOOK_IMAGE_TAG:=notebook-gpu-latest}"
: "${HE_CPU_IMAGE:=${HE_IMAGE_REPOSITORY}:${HE_CPU_IMAGE_TAG}}"
: "${HE_GPU_IMAGE:=${HE_IMAGE_REPOSITORY}:${HE_GPU_IMAGE_TAG}}"
: "${HE_NOTEBOOK_IMAGE:=${HE_IMAGE_REPOSITORY}:${HE_NOTEBOOK_IMAGE_TAG}}"
: "${HE_SDK_CPU_WORKER_IMAGE:=${HE_IMAGE_REPOSITORY}:sdk-worker-cpu-latest}"
: "${HE_SDK_GPU_WORKER_IMAGE:=${HE_IMAGE_REPOSITORY}:sdk-worker-gpu-latest}"
: "${HE_FIDES_EXAMPLES_IMAGE:=${HE_GPU_IMAGE}}"
: "${HE_BENCH_CLIENT_IMAGE:=${HE_CPU_IMAGE}}"
: "${HE_SDK_SMOKE_JOB:=he-sdk-smoke}"
# Leave stress-Job images empty by default. Their scripts copy the immutable
# image reference from the live CPU evaluator Deployment instead of silently
# falling back to cpu-latest. Set either only as an explicit override.
: "${HE_COMPARE_IMAGE:=}"
: "${HE_COMPARE_DATA_IMAGE:=}"
: "${HE_COMPARE_DATA_PVC:=he-comparison-data}"
: "${HE_COMPARE_DATA_STORAGE:=10Gi}"
: "${HE_NORMAL_DATA_PVC:=${HE_COMPARE_DATA_PVC}}"
: "${HE_NORMAL_DATA_STORAGE:=${HE_COMPARE_DATA_STORAGE}}"
: "${HE_STRESS_DATA_PVC:=he-stress-data}"
: "${HE_STRESS_DATA_STORAGE:=100Gi}"

: "${HE_CPU_DEPLOYMENT:=he-evaluator-cpu}"
: "${HE_GPU_DEPLOYMENT:=he-evaluator-gpu}"
: "${HE_CPU_SERVICE:=he-evaluator}"
: "${HE_GPU_SERVICE:=he-evaluator-gpu}"
: "${HE_SERVICE_PORT:=8080}"
: "${HE_CPU_LOCAL_PORT:=18080}"
: "${HE_GPU_LOCAL_PORT:=18081}"

# Interactive FIDES GPU notebook. GitLab builds the image on a CPU-only runner;
# the Pod startup gate performs the first real GPU operation on this node. It
# is exposed as ClusterIP only; use port-forward and the Kubernetes token.
: "${HE_NOTEBOOK_DEPLOYMENT:=he-notebook}"
: "${HE_NOTEBOOK_SERVICE:=he-notebook}"
: "${HE_NOTEBOOK_PVC:=he-notebook-workspace}"
: "${HE_NOTEBOOK_CONFIGMAP:=he-notebook-content}"
: "${HE_NOTEBOOK_SECRET:=he-notebook-auth}"
: "${HE_NOTEBOOK_PORT:=8888}"
: "${HE_NOTEBOOK_LOCAL_PORT:=18888}"
: "${HE_NOTEBOOK_STORAGE:=2Gi}"
: "${HE_NOTEBOOK_BACKEND:=fides}"
: "${HE_NOTEBOOK_GPU_DEVICE:=0}"
: "${HE_NOTEBOOK_WORKSPACE:=/workspace/he-sdk-workspace}"
: "${HE_NOTEBOOK_REQUEST_CPU:=2}"
: "${HE_NOTEBOOK_REQUEST_MEMORY:=4Gi}"
: "${HE_NOTEBOOK_LIMIT_CPU:=8}"
: "${HE_NOTEBOOK_LIMIT_MEMORY:=16Gi}"
: "${HE_NOTEBOOK_GPU_COUNT:=1}"
: "${HE_NOTEBOOK_GPU_NODE_NAME:=hht-k8s-staging-22}"
: "${HE_NOTEBOOK_GPU_TAINT_VALUE:=T4}"

# PostgreSQL storage for HE run metadata and encrypted/public artifacts. The
# Service remains cluster-private; scripts/postgres/forward.sh is the explicit
# access path from a kubectl/Tailscale host.
: "${HE_POSTGRES_IMAGE:=docker.io/dockerboi99/he_k8s:postgres-latest}"
: "${HE_POSTGRES_STATEFULSET:=he-postgres}"
: "${HE_POSTGRES_SERVICE:=he-postgres}"
: "${HE_POSTGRES_PVC:=he-postgres-data}"
: "${HE_POSTGRES_SECRET:=he-postgres-auth}"
: "${HE_POSTGRES_SCHEMA_CONFIGMAP:=he-postgres-schema}"
: "${HE_POSTGRES_SCHEMA_JOB_PREFIX:=he-postgres-schema-}"
: "${HE_POSTGRES_DATABASE:=he_store}"
: "${HE_POSTGRES_USER:=he_app}"
: "${HE_POSTGRES_PORT:=5432}"
: "${HE_POSTGRES_LOCAL_PORT:=15432}"
: "${HE_POSTGRES_FORWARD_ADDRESS:=127.0.0.1}"
: "${HE_POSTGRES_STORAGE:=10Gi}"
: "${HE_POSTGRES_REQUEST_CPU:=100m}"
: "${HE_POSTGRES_REQUEST_MEMORY:=256Mi}"
: "${HE_POSTGRES_LIMIT_CPU:=1}"
: "${HE_POSTGRES_LIMIT_MEMORY:=1Gi}"
: "${HE_POSTGRES_SCHEMA_TIMEOUT:=5m}"

: "${HE_CPU_SERVICE_URL:=http://${HE_CPU_SERVICE}:${HE_SERVICE_PORT}/v1/evaluate}"
: "${HE_GPU_SERVICE_URL:=http://${HE_GPU_SERVICE}:${HE_SERVICE_PORT}/v1/evaluate}"

# Evaluator Pod resource requests reserve scheduler capacity. Limits cap the
# maximum CPU/memory available to each evaluator container.
: "${HE_CPU_REQUEST_CPU:=1}"
: "${HE_CPU_REQUEST_MEMORY:=2Gi}"
: "${HE_CPU_LIMIT_CPU:=4}"
: "${HE_CPU_LIMIT_MEMORY:=8Gi}"

: "${HE_GPU_REQUEST_CPU:=2}"
: "${HE_GPU_REQUEST_MEMORY:=4Gi}"
: "${HE_GPU_LIMIT_CPU:=8}"
: "${HE_GPU_LIMIT_MEMORY:=16Gi}"
: "${HE_GPU_COUNT:=1}"
: "${HE_GPU_NODE_NAME:=hht-k8s-staging-22}"
: "${HE_GPU_TAINT_VALUE:=T4}"

# Batch SDK workers materialize secretless workspaces from PostgreSQL into an
# emptyDir, so a GPU Job does not need to mount the notebook's RWO PVC.
: "${HE_SDK_WORKER_TIMEOUT_SECONDS:=1800}"
: "${HE_SDK_WORKER_TTL_SECONDS:=600}"
: "${HE_SDK_WORKER_TMP_STORAGE:=2Gi}"
: "${HE_SDK_CPU_WORKER_REQUEST_CPU:=2}"
: "${HE_SDK_CPU_WORKER_REQUEST_MEMORY:=4Gi}"
: "${HE_SDK_CPU_WORKER_LIMIT_CPU:=4}"
: "${HE_SDK_CPU_WORKER_LIMIT_MEMORY:=8Gi}"
: "${HE_SDK_GPU_WORKER_REQUEST_CPU:=2}"
: "${HE_SDK_GPU_WORKER_REQUEST_MEMORY:=4Gi}"
: "${HE_SDK_GPU_WORKER_LIMIT_CPU:=8}"
: "${HE_SDK_GPU_WORKER_LIMIT_MEMORY:=16Gi}"

# Benchmark Job resources are separate from evaluator Pod resources. Increase
# these values when the client, report comparison, or reusable-data generator
# reaches its own CPU, memory, or temporary-storage limit.
: "${HE_BENCH_REQUEST_CPU:=1}"
: "${HE_BENCH_REQUEST_MEMORY:=2Gi}"
: "${HE_BENCH_LIMIT_CPU:=2}"
: "${HE_BENCH_LIMIT_MEMORY:=4Gi}"
: "${HE_BENCH_TMP_STORAGE:=2Gi}"

# The SDK Job installs the wheel bundled in an immutable CPU image into an
# emptyDir. It executes locally in the Job Pod and does not call the evaluator
# Service, so it verifies the installable SDK path rather than the HTTP path.
: "${HE_SDK_SMOKE_REQUEST_CPU:=1}"
: "${HE_SDK_SMOKE_REQUEST_MEMORY:=2Gi}"
: "${HE_SDK_SMOKE_LIMIT_CPU:=4}"
: "${HE_SDK_SMOKE_LIMIT_MEMORY:=8Gi}"
: "${HE_SDK_SMOKE_TMP_STORAGE:=512Mi}"
: "${HE_SDK_SMOKE_TIMEOUT_SECONDS:=1800}"
: "${HE_SDK_SMOKE_TTL_SECONDS:=600}"

: "${HE_SUM_BENCH_REQUEST_CPU:=1}"
: "${HE_SUM_BENCH_REQUEST_MEMORY:=2Gi}"
: "${HE_SUM_BENCH_LIMIT_CPU:=4}"
: "${HE_SUM_BENCH_LIMIT_MEMORY:=8Gi}"
: "${HE_SUM_BENCH_TMP_STORAGE:=4Gi}"

: "${HE_COMPARE_REQUEST_CPU:=1}"
: "${HE_COMPARE_REQUEST_MEMORY:=2Gi}"
: "${HE_COMPARE_LIMIT_CPU:=4}"
: "${HE_COMPARE_LIMIT_MEMORY:=8Gi}"
: "${HE_COMPARE_TMP_STORAGE:=4Gi}"

: "${HE_COMPARE_DATA_REQUEST_CPU:=250m}"
: "${HE_COMPARE_DATA_REQUEST_MEMORY:=256Mi}"
: "${HE_COMPARE_DATA_LIMIT_CPU:=2}"
: "${HE_COMPARE_DATA_LIMIT_MEMORY:=1Gi}"
: "${HE_COMPARE_DATA_TMP_STORAGE:=64Mi}"

# Multiplication-range data is generated per chunk and does not use a PVC.
: "${HE_MULTIPLY_RANGE_REQUEST_CPU:=1}"
: "${HE_MULTIPLY_RANGE_REQUEST_MEMORY:=512Mi}"
: "${HE_MULTIPLY_RANGE_LIMIT_CPU:=2}"
: "${HE_MULTIPLY_RANGE_LIMIT_MEMORY:=2Gi}"
: "${HE_MULTIPLY_RANGE_TMP_STORAGE:=256Mi}"

# Small correctness Jobs for the real ciphertext /v1/evaluate boundary.
: "${HE_EVALUATE_API_PVC:=he-evaluate-api-artifacts}"
: "${HE_EVALUATE_API_STORAGE:=2Gi}"
: "${HE_EVALUATE_API_REQUEST_CPU:=1}"
: "${HE_EVALUATE_API_REQUEST_MEMORY:=2Gi}"
: "${HE_EVALUATE_API_LIMIT_CPU:=4}"
: "${HE_EVALUATE_API_LIMIT_MEMORY:=8Gi}"
: "${HE_EVALUATE_API_TMP_STORAGE:=1Gi}"
: "${HE_EVALUATE_API_JOB_TTL_SECONDS:=600}"
: "${HE_EVALUATE_API_JOB_TIMEOUT_SECONDS:=1800}"
: "${HE_EVALUATE_API_REQUEST_TIMEOUT_SECONDS:=600}"
: "${HE_EVALUATE_API_TOLERANCE:=0.001}"

# Kubernetes removes completed comparison/data Jobs after this many seconds.
: "${HE_COMPARE_JOB_TTL_SECONDS:=600}"
